# Copy to .env (git-ignored). Everything here is optional for plain
# `make run` on localhost; the values below enable https://dev.tangostack.com.
# SECRET_KEY=
# DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,dev.tangostack.com
CSRF_TRUSTED_ORIGINS=https://dev.tangostack.com
BEHIND_PROXY=true
# Social login: Google OAuth client (without both, the Google button is hidden).
# Redirect URI to register: https://dev.tangostack.com/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email. Without these, development prints emails to the console. To read them in
# Mailpit (http://localhost:8025, started by `make mailpit`) use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=false
# In production use the provider's SMTP credentials (SMTP is the default backend
# when DEBUG is off). EMAIL_PORT may be left out: 587 with STARTTLS, or 465 with
# EMAIL_USE_SSL=true.
# EMAIL_HOST=
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# DEFAULT_FROM_EMAIL=Tangostack <noreply@your-domain>
